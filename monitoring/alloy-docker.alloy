discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "everunfold" {
  targets = discovery.docker.local.targets
  rule {
    action = "keep"
    source_labels = [
      "__meta_docker_container_label_org_everunfold_deployment",
      "__meta_docker_container_label_org_everunfold_component",
    ]
    regex = ".+;.*|.*;(backend|frontend)"
  }
  rule {
    action = "keep"
    source_labels = ["__meta_docker_container_name"]
    regex = coalesce(sys.env("EVERUNFOLD_LOG_CONTAINER_MATCH"), ".*")
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/?(.+)"
    target_label = "container"
  }
}

loki.source.docker "everunfold" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.everunfold.output
  forward_to = [loki.process.everunfold.receiver]
}

loki.process "everunfold" {
  forward_to = [loki.write.central.receiver]

  stage.json {
    expressions = {component = "component"}
  }
  stage.template {
    source = "component"
    template = "{{ if or (eq .Value \"nodejs\") (eq .Value \"fastapi\") (eq .Value \"celery\") (eq .Value \"scheduler\") }}{{ .Value }}{{ else }}runtime{{ end }}"
  }
  stage.labels {
    values = {component = "component"}
  }
  stage.static_labels {
    values = {
      app = "everunfold",
      env = sys.env("EVERUNFOLD_ENVIRONMENT"),
      node = sys.env("EVERUNFOLD_LOG_NODE"),
    }
  }
  stage.match {
    selector = "{app=\"everunfold\",component!~\"" + coalesce(sys.env("EVERUNFOLD_LOG_COMPONENT_MATCH"), ".*") + "\"}"
    action = "drop"
    drop_counter_reason = "component_filter"
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}
